@page "/users/set-password"

@using LMS.Shared.DTOs.UserDtos
@using LMS.Blazor.Client.Services.ApiProxy

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Set Password</PageTitle>

<h3>Set Your Password</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (success)
{
    <div class="alert alert-success">
        Your password has been set successfully.
    </div>

    <a href="/Account/Login"
       class="btn btn-primary">
        Go to Login
    </a>
}
else
{
    <EditForm Model="model"
              OnValidSubmit="SubmitPassword">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <div class="mb-3">

            <label class="form-label">
                New Password
            </label>

            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.Password" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Confirm Password
            </label>

            <InputText class="form-control"
                       type="password"
                       @bind-Value="model.ConfirmPassword" />

        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">

            @if (isSaving)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>Set Password</span>
            }

        </button>

    </EditForm>
}

@code
{
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private SetPasswordDto model = new();

    private bool isSaving;

    private bool success;

    private string? errorMessage;

    private async Task SubmitPassword()
    {
        if (string.IsNullOrWhiteSpace(UserId) ||
            string.IsNullOrWhiteSpace(Token))
        {
            errorMessage =
                "The password setup link is invalid.";

            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            errorMessage =
                "Passwords do not match.";

            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            model.UserId = UserId;
            model.Token = Token;

            await ApiProxyClient.PostAsync<SetPasswordDto, object>(
                "users/set-password",
                model);

            success = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}