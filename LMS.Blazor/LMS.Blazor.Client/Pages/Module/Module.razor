@page "/modules/{Id:int}"

@using LMS.Blazor.Client.Components
@using LMS.Shared.DTOs.Activity
@using LMS.Shared.DTOs.Module
@using LMS.Shared.Paging
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student,Teacher")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Module</PageTitle>

<h3 class="mb-4">Module</h3>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage) && module is null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (module is not null)
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <tbody>
                        <tr>
                            <td>Course ID</td>
                            <td>@module.CourseId</td>
                        </tr>
                        <tr>
                            <td>Module Name</td>
                            <td>@module.Name</td>
                        </tr>
                        <tr>
                            <td>Description</td>
                            <td>@module.Description</td>
                        </tr>

                        <tr>
                            <td>Start Date</td>
                            <td>@module.StartDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                        <tr>
                            <td>End Date</td>
                            <td>@module.EndDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card my-3">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h4 class="mb-0">Activities</h4>
                <AuthorizeView Roles="Teacher">
                    <a class="btn btn-sm btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                       href="@($"/activities/create/{Id}")">
                        <span class="bi bi-plus-circle" aria-hidden="true"></span>
                        Add Activity
                    </a>
                </AuthorizeView>
            </div>

            @if (activitiesError is not null)
            {
                <p class="alert alert-danger mb-0" role="alert">@activitiesError</p>
            }
            else if (activities is null)
            {
                <p class="text-muted mb-0">Loading...</p>
            }
            else if (activities.Count == 0)
            {
                <p class="text-muted mb-0">No activities created yet.</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var activity in activities)
                    {
                        <li class="list-group-item d-flex flex-wrap justify-content-between gap-2" @key="activity.Id">
                            <div>
                                <a class="fw-bold" href="@($"/activities/{activity.Id}")">@activity.Title</a>
                                <span class="badge text-bg-light ms-2">@activity.ActionTypeName</span>
                            </div>
                            <span class="text-muted">
                                @activity.StartDate.ToString("yyyy-MM-dd HH:mm")
                                –
                                @activity.EndDate.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <CourseDocuments Id="Id" Type="module"></CourseDocuments>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateModuleDto? module;
    private List<ActivityDto>? activities;
    private bool isLoading = true;
    private string? errorMessage;
    private string? activitiesError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadModule();

        if (module is not null)
        {
            await LoadActivities();
        }
    }

    private async Task LoadActivities()
    {
        activities = null;
        activitiesError = null;

        try
        {
            // 100 is the API's largest page size
            var response =
                await ApiProxyClient.GetAsync<PagedResponse<ActivityDto>>(
                    $"Activity/module/{Id}?PageNumber=1&PageSize=100");

            activities = response?.Items
                .OrderBy(a => a.StartDate)
                .ThenBy(a => a.Id)
                .ToList() ?? [];
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            activitiesError = ex.Message;
        }
    }

    private async Task LoadModule()
    {
        isLoading = true;
        errorMessage = null;
        module = null;

        try
        {
            var existing =
                await ApiProxyClient.GetAsync<ModuleDto>(
                    $"Module/{Id}");

            if (existing is null)
            {
                errorMessage = "Module not found.";
                return;
            }

            module = new UpdateModuleDto
            {
                CourseId = existing.CourseId,
                Name = existing.Name,
                Description = existing.Description,
                StartDate = existing.StartDate,
                EndDate = existing.EndDate
            };
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}