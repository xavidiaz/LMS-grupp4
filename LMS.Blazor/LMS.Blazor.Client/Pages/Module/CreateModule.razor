
@page "/modules/create/{CourseId:int}"

@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.Module
@using LMS.Shared.Paging
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Create Module</PageTitle>

<div class="create-module-page">

    <!-- PAGE HEADER -->
    <header class="create-module-header">
        <div class="create-module-header-text">
            <h1>Create Module</h1>
            <p>Add a new module and manage its information and schedule.</p>
        </div>
    </header>

    <!-- MAIN CARD -->
    <section class="card create-module-card">

        <!-- CARD HEADER -->
        <div class="card-header create-module-card-header">
            <div>
                <h2>Module Information</h2>
                <p>Enter the details for the new module below.</p>
            </div>

            <span class="create-module-header-icon bi bi-collection"
                  aria-hidden="true"></span>
        </div>

        <!-- ERROR MESSAGE -->
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger create-module-error" role="alert">
                <span class="bi bi-exclamation-circle"
                      aria-hidden="true"></span>
                <span>@errorMessage</span>
            </div>
        }

        @if (isLoading)
        {
            <div class="create-module-state">
                <div class="spinner-border create-module-spinner"
                     role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <strong>Loading course...</strong>
            </div>
        }
        else if (course is not null)
        {
        <!-- CREATE FORM -->
        <EditForm Model="module" OnValidSubmit="CreateModules">

            <DataAnnotationsValidator />

            <div class="create-module-form">

                <div class="create-module-validation">
                    <ValidationSummary />
                </div>

                <!-- COURSE INFORMATION -->
                <div class="create-module-info">

                    <span class="create-module-info-icon bi bi-info-circle"
                          aria-hidden="true"></span>

                    <div>
                        <strong>@course.Name</strong>

                        <p>
                            @course.StartDate.ToString("yyyy-MM-dd")
                            –
                            @course.EndDate.ToString("yyyy-MM-dd")
                        </p>

                        <div class="create-module-periods">
                            <div>
                                <strong>Booked</strong>

                                @if (bookedModules.Count == 0)
                                {
                                    <p>No modules created yet.</p>
                                }

                                @foreach (var booked in bookedModules)
                                {
                                    <p @key="booked.Id">
                                        @booked.Name:
                                        @booked.StartDate.ToString("yyyy-MM-dd")
                                        –
                                        @booked.EndDate.ToString("yyyy-MM-dd")
                                    </p>
                                }
                            </div>

                            <div>
                                <strong>Available</strong>

                                @if (availablePeriods.Count == 0)
                                {
                                    <p>No available dates</p>
                                }

                                @foreach (var period in availablePeriods)
                                {
                                    <p @key="period.Start">
                                        @period.Start.ToString("yyyy-MM-dd")
                                        –
                                        @period.End.ToString("yyyy-MM-dd")
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- MODULE NAME -->
                <div>
                    <label class="form-label" for="moduleName">
                        Module Name
                    </label>

                    <InputText id="moduleName"
                               class="form-control"
                               @bind-Value="module.Name"
                               placeholder="Enter module name" />

                    <ValidationMessage
                        For="@(() => module.Name)" />
                </div>

                <!-- DESCRIPTION -->
                <div>
                    <label class="form-label" for="moduleDescription">
                        Description
                    </label>

                    <InputTextArea id="moduleDescription"
                                   class="form-control"
                                   @bind-Value="module.Description"
                                   placeholder="Enter module description"
                                   rows="4" />

                    <ValidationMessage
                        For="@(() => module.Description)" />
                </div>

                <!-- DATE FIELDS -->
                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="form-label" for="moduleStartDate">
                            Start Date
                        </label>

                        <InputDate id="moduleStartDate"
                                   class="form-control"
                                   @bind-Value="module.StartDate" />

                        <ValidationMessage
                            For="@(() => module.StartDate)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="moduleEndDate">
                            End Date
                        </label>

                        <InputDate id="moduleEndDate"
                                   class="form-control"
                                   @bind-Value="module.EndDate" />

                        <ValidationMessage
                            For="@(() => module.EndDate)" />
                    </div>

                </div>

            </div>

            <!-- FORM FOOTER -->
            <div class="create-module-footer">

                <a class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                   href="@($"/courses/{CourseId}/modules")">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                        disabled="@isSaving">

                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true"></span>

                        <span>Creating...</span>
                    }
                    else
                    {
                        <span class="bi bi-plus-circle"
                              aria-hidden="true"></span>

                        <span>Create Module</span>
                    }

                </button>

            </div>

        </EditForm>
        }

    </section>

</div>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private sealed record DatePeriod(DateTime Start, DateTime End);

    private CreateModuleDto module = new();
    private CourseDto? course;
    private List<ModuleDto> bookedModules = [];
    private List<DatePeriod> availablePeriods = [];

    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override void OnParametersSet()
    {
        module.CourseId = CourseId;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var loadedCourse =
                await ApiProxyClient.GetAsync<CourseDto>(
                    $"courses/{CourseId}");

            var response =
                await ApiProxyClient.GetAsync<PagedResponse<ModuleDto>>(
                    $"Module/course/{CourseId}");

            if (loadedCourse is null)
            {
                errorMessage = "The course could not be loaded.";
                return;
            }

            bookedModules = response?.Items
                .OrderBy(m => m.StartDate)
                .ThenBy(m => m.Id)
                .ToList() ?? [];

            availablePeriods =
                GetAvailablePeriods(loadedCourse, bookedModules);

            var defaultPeriod = availablePeriods.FirstOrDefault()
                ?? new DatePeriod(loadedCourse.StartDate, loadedCourse.EndDate);

            module.StartDate = defaultPeriod.Start;
            module.EndDate = defaultPeriod.End;
            course = loadedCourse;
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Expects modules sorted by start date. A day with a module counts as booked.
    private static List<DatePeriod> GetAvailablePeriods(
        CourseDto course,
        List<ModuleDto> modules)
    {
        var periods = new List<DatePeriod>();
        var nextFree = course.StartDate;

        foreach (var booked in modules)
        {
            var lastFree = booked.StartDate.Date.AddDays(-1);

            if (nextFree.Date <= lastFree)
            {
                periods.Add(new DatePeriod(nextFree, lastFree));
            }

            var afterModule = booked.EndDate.Date.AddDays(1);

            if (afterModule > nextFree)
            {
                nextFree = afterModule;
            }
        }

        if (nextFree.Date <= course.EndDate.Date)
        {
            periods.Add(new DatePeriod(nextFree, course.EndDate));
        }

        return periods;
    }

    private async Task CreateModules()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            module.CourseId = CourseId;

            var created =
                await ApiProxyClient.PostAsync<CreateModuleDto, ModuleDto>(
                    "Module",
                    module);

            NavigationManager.NavigateTo(
                $"/courses/{CourseId}/modules");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
