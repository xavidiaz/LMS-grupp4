
@page "/activities/create/{ModuleId:int}"

@using LMS.Shared.DTOs.Activity
@using LMS.Shared.DTOs.Module
@using LMS.Shared.DTOs.ActionType
@using LMS.Shared.Paging
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Create Activity</PageTitle>

<div class="create-activity-page">

    <!-- PAGE HEADER -->
    <header class="create-activity-header">
        <div class="create-activity-header-text">
            <h1>Create Activity</h1>
            <p>Add a new activity and schedule it within a course module.</p>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="card create-activity-card">
            <div class="create-activity-state">

                <div class="spinner-border create-activity-spinner"
                     role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <strong>Loading module information...</strong>
                <p>Please wait while we prepare the activity form.</p>

            </div>
        </div>
    }
    else if (module is null)
    {
        <div class="card create-activity-card">

            <div class="alert alert-danger create-activity-error" role="alert">
                <span class="bi bi-exclamation-circle"
                      aria-hidden="true"></span>
                <span>
                    @(errorMessage ?? "The module could not be loaded.")
                </span>
            </div>

            <div class="create-activity-footer">
                <a class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                   href="/courses">
                    <span class="bi bi-arrow-left"
                          aria-hidden="true"></span>
                    Back to Courses
                </a>
            </div>

        </div>
    }
    else
    {
        <div class="card create-activity-card">

            <!-- CARD HEADER -->
            <div class="card-header create-activity-card-header">
                <div>
                    <h2>Activity Information</h2>
                    <p>Enter the details for the new activity below.</p>
                </div>

                <span class="create-activity-header-icon bi bi-calendar-plus"
                      aria-hidden="true"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger create-activity-error" role="alert">
                    <span class="bi bi-exclamation-circle"
                          aria-hidden="true"></span>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- CREATE FORM -->
            <EditForm Model="activity"
                      OnValidSubmit="Create">

                <DataAnnotationsValidator />

                <div class="create-activity-form">

                    <div class="create-activity-validation">
                        <ValidationSummary />
                    </div>

                    <!-- MODULE INFORMATION -->
                    <div class="create-activity-info">

                        <span class="create-activity-info-icon bi bi-info-circle"
                              aria-hidden="true"></span>

                        <div>
                            <strong>@module.Name</strong>

                            <p class="create-activity-period">
                                @module.StartDate.ToString("yyyy-MM-dd")
                                –
                                @module.EndDate.ToString("yyyy-MM-dd")
                            </p>

                            <p>
                                The activity must be scheduled within this
                                period and must not overlap another activity
                                in the module.
                            </p>

                            <div class="create-activity-periods">
                                <div>
                                    <strong>Booked</strong>

                                    @if (bookedActivities.Count == 0)
                                    {
                                        <p>No activities created yet.</p>
                                    }

                                    @foreach (var booked in bookedActivities)
                                    {
                                        <p @key="booked.Id">
                                            @booked.Title:
                                            @booked.StartDate.ToString("yyyy-MM-dd HH:mm")
                                            –
                                            @booked.EndDate.ToString("yyyy-MM-dd HH:mm")
                                        </p>
                                    }
                                </div>

                                <div>
                                    <strong>Available</strong>

                                    @if (availablePeriods.Count == 0)
                                    {
                                        <p>No available dates</p>
                                    }

                                    @foreach (var period in availablePeriods)
                                    {
                                        <p @key="period.Start">
                                            @period.Start.ToString("yyyy-MM-dd HH:mm")
                                            –
                                            @period.End.ToString("yyyy-MM-dd HH:mm")
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ACTIVITY TYPE -->
                    <div>

                        <label class="form-label" for="activityType">
                            Activity Type
                        </label>

                        <InputSelect id="activityType"
                                     class="form-select"
                                     @bind-Value="activity.ActionTypeId">

                            <option value="0">
                                -- Select Activity Type --
                            </option>

                            @foreach (var actionType in actionTypes)
                            {
                                <option value="@actionType.Id">
                                    @actionType.Name
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage
                            For="@(() => activity.ActionTypeId)" />

                    </div>

                    <!-- TITLE -->
                    <div>

                        <label class="form-label" for="activityTitle">
                            Title
                        </label>

                        <InputText id="activityTitle"
                                   class="form-control"
                                   @bind-Value="activity.Title"
                                   placeholder="Enter activity title" />

                        <ValidationMessage
                            For="@(() => activity.Title)" />

                    </div>

                    <!-- DESCRIPTION -->
                    <div>

                        <label class="form-label" for="activityDescription">
                            Description
                        </label>

                        <InputTextArea id="activityDescription"
                                       class="form-control"
                                       @bind-Value="activity.Description"
                                       rows="4"
                                       placeholder="Describe the activity" />

                        <ValidationMessage
                            For="@(() => activity.Description)" />

                    </div>

                    <!-- DATE AND TIME -->
                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="form-label" for="activityStart">
                                Start Time
                            </label>

                            <InputDate id="activityStart"
                                       class="form-control"
                                       Type="InputDateType.DateTimeLocal"
                                       @bind-Value="activity.StartDate" />

                            <ValidationMessage
                                For="@(() => activity.StartDate)" />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label" for="activityEnd">
                                End Time
                            </label>

                            <InputDate id="activityEnd"
                                       class="form-control"
                                       Type="InputDateType.DateTimeLocal"
                                       @bind-Value="activity.EndDate" />

                            <ValidationMessage
                                For="@(() => activity.EndDate)" />

                        </div>

                    </div>

                </div>

                <!-- FORM FOOTER -->
                <div class="create-activity-footer">

                    <a class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                       href="@($"/modules/{ModuleId}/activities")">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-hidden="true"></span>

                            <span>Creating...</span>
                        }
                        else
                        {
                            <span class="bi bi-plus-circle"
                                  aria-hidden="true"></span>

                            <span>Create Activity</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>
    }

</div>

@code {
    [Parameter]
    public int ModuleId { get; set; }

    private sealed record DatePeriod(DateTime Start, DateTime End);

    private static readonly TimeSpan DefaultDuration = TimeSpan.FromHours(1);

    private CreateActivityDto activity = new();
    private ModuleDto? module;
    private List<ActionTypeDto> actionTypes = new();
    private List<ActivityDto> bookedActivities = [];
    private List<DatePeriod> availablePeriods = [];

    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        activity = new CreateActivityDto
        {
            ModuleId = ModuleId
        };

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        module = null;
        actionTypes = new();

        try
        {
            // Load module information
            module = await ApiProxyClient.GetAsync<ModuleDto>(
                $"Module/{ModuleId}");

            if (module is null)
            {
                errorMessage = "Module not found.";
                return;
            }

            // Load booked activities, 100 is the API's largest page size
            var activitiesResponse = await ApiProxyClient
                .GetAsync<PagedResponse<ActivityDto>>(
                    $"Activity/module/{ModuleId}?PageNumber=1&PageSize=100");

            bookedActivities = activitiesResponse?.Items
                .OrderBy(a => a.StartDate)
                .ThenBy(a => a.Id)
                .ToList() ?? [];

            availablePeriods =
                GetAvailablePeriods(module, bookedActivities);

            var defaultPeriod = availablePeriods.FirstOrDefault()
                ?? new DatePeriod(module.StartDate, module.EndDate);

            activity.StartDate = defaultPeriod.Start;
            activity.EndDate = defaultPeriod.Start + DefaultDuration < defaultPeriod.End
                ? defaultPeriod.Start + DefaultDuration
                : defaultPeriod.End;

            // Load action types from the paginated API response
            var response = await ApiProxyClient
                .GetAsync<PagedResponse<ActionTypeDto>>("ActionType");

            actionTypes = response?.Items?.ToList()
                ?? new List<ActionTypeDto>();

            if (actionTypes.Count == 0)
            {
                errorMessage = "No activity types are available.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            // Without this data the form would show invalid defaults
            module = null;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Expects activities sorted by start time.
    private static List<DatePeriod> GetAvailablePeriods(
        ModuleDto module,
        List<ActivityDto> activities)
    {
        var periods = new List<DatePeriod>();
        var nextFree = module.StartDate;

        foreach (var booked in activities)
        {
            var lastFree = booked.StartDate < module.EndDate
                ? booked.StartDate
                : module.EndDate;

            if (nextFree < lastFree)
            {
                periods.Add(new DatePeriod(nextFree, lastFree));
            }

            if (booked.EndDate > nextFree)
            {
                nextFree = booked.EndDate;
            }
        }

        if (nextFree < module.EndDate)
        {
            periods.Add(new DatePeriod(nextFree, module.EndDate));
        }

        return periods;
    }

    private async Task Create()
    {
        if (isSaving || module is null)
            return;

        errorMessage = null;

        if (activity.ActionTypeId <= 0 ||
            !actionTypes.Any(x => x.Id == activity.ActionTypeId))
        {
            errorMessage = "Please select a valid activity type.";
            return;
        }

        if (activity.StartDate >= activity.EndDate)
        {
            errorMessage =
                "The start time must be earlier than the end time.";
            return;
        }

        if (activity.StartDate < module.StartDate ||
            activity.EndDate > module.EndDate)
        {
            errorMessage =
                "The activity must be within the module's date range.";
            return;
        }

        activity.ModuleId = ModuleId;
        isSaving = true;

        try
        {
            await ApiProxyClient.PostAsync<CreateActivityDto, ActivityDto>(
                "Activity",
                activity);

            NavigationManager.NavigateTo(
                $"/modules/{ModuleId}/activities");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
