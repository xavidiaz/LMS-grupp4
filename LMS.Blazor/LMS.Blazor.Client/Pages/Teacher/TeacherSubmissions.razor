
@page "/teacher/submissions"

@using System.Net.Http
@using System.Net.Http.Json
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.SubmissionDtos
@using LMS.Shared.DTOs.FeedbackDtos
@using LMS.Shared.Paging
@using Microsoft.AspNetCore.Authorization

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Teacher")]

<PageTitle>Student Submissions</PageTitle>

<div class="teacher-submissions-page">

    <PageHeader Title="Student Submissions"
                Description="Monitor student submissions, deadlines, and missing work." />

    <div class="submission-filters">

        <div class="filter-field">
            <label class="form-label" for="activity">Assignment</label>
            <select class="form-select" id="activity" @bind="selectedActivityId">
                <option value="">All assignments</option>
                @foreach (var activity in activities)
                {
                    <option value="@activity.ActivityId">
                        @activity.ActivityTitle
                    </option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label class="form-label" for="status">Submission status</label>
            <select class="form-select" id="status" @bind="selectedStatus">
                <option value="">All statuses</option>
                <option value="Submitted">Submitted</option>
                <option value="Late">Late</option>
                <option value="Missing">Missing</option>
                <option value="Overdue">Overdue</option>
            </select>
        </div>

        <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                @onclick="ApplyFiltersAsync"
                disabled="@isLoading">
            Apply filters
        </button>

        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                @onclick="ClearFiltersAsync"
                disabled="@isLoading">
            Clear
        </button>
    </div>

    @if (isLoading)
    {
        <ContentState Type="loading" />
    }
    else if (hasError)
    {
        <ContentState Type="error" Message="@errorMessage" />

        <button class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                @onclick="LoadSubmissionsAsync">
            Try again
        </button>
    }
    else if (submissions.Count == 0)
    {
        <ContentState Type="empty"
                      Message="No records match your filters." />
    }
    else
    {
        <div class="submission-summary">
            <div class="card summary-card">
                <span>Total records</span>
                <strong>@totalCount</strong>
            </div>

            <div class="card summary-card">
                <span>Submitted</span>
                <strong>@CountStatus("Submitted")</strong>
            </div>

            <div class="card summary-card">
                <span>Late</span>
                <strong>@CountStatus("Late")</strong>
            </div>

            <div class="card summary-card">
                <span>Missing / overdue</span>
                <strong>@(CountStatus("Missing") + CountStatus("Overdue"))</strong>
            </div>
        </div>

        <div class="table-responsive submission-table-wrapper">
            <table class="table table-hover align-middle mb-0 submission-table">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Assignment</th>
                        <th>Deadline</th>
                        <th>Submitted at</th>
                        <th>Status</th>
                        <th>File</th>
                        <th>Feedback</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in submissions)
                    {
                        <tr @key="(item.StudentId, item.ActivityId)">
                            <td>
                                <strong>@item.StudentName</strong>
                                <div class="student-email">
                                    @item.StudentEmail
                                </div>
                            </td>

                            <td>@item.ActivityTitle</td>

                            <td>
                                @item.Deadline.ToString("dd MMM yyyy HH:mm")
                            </td>

                            <td>
                                @(item.SubmittedAt.HasValue
                                    ? item.SubmittedAt.Value.ToString("dd MMM yyyy HH:mm")
                                    : "Not submitted")
                            </td>

                            <td>
                                <span class="badge submission-status @GetStatusClass(item.Status)">
                                    @GetStatusText(item.Status)
                                </span>
                            </td>

                            <td>
                                @if (item.SubmissionId.HasValue)
                                {
                                    <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                                       href="@GetDownloadUrl(item.SubmissionId.Value)">
                                        Download
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(item.FileName))
                                    {
                                        <div class="file-name">
                                            @item.FileName
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="no-file">No file</span>
                                }
                            </td>

                            <td>
                                @if (item.SubmissionId.HasValue)
                                {
                                    <button type="button"
                                            class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                                            @onclick="() => OpenFeedback(item)">
                                        Give Feedback
                                    </button>
                                }
                                else
                                {
                                    <span class="no-file">No submission</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="submission-pagination">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                    @onclick="PreviousPageAsync"
                    disabled="@(pageNumber <= 1 || isLoading)">
                Previous
            </button>

            <span>Page @pageNumber</span>

            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                    @onclick="NextPageAsync"
                    disabled="@(!hasMorePages || isLoading)">
                Next
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(downloadError))
    {
        <p class="alert alert-danger submission-error" role="alert">
            @downloadError
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(feedbackSuccess))
    {
        <p class="alert alert-success feedback-success" role="status">
            @feedbackSuccess
        </p>
    }

    @if (showFeedbackModal && selectedSubmission is not null)
    {
        <div class="modal d-flex align-items-center justify-content-center feedback-modal-backdrop" @onclick="CloseFeedback">
            <div class="modal-content feedback-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="feedback-modal-title"
                 @onclick:stopPropagation="true">

                @if(latestFeedback is not null)
                {
                    <h2 id="feedback-modal-title">Give another feedback</h2>

                }
                else
                {
                    <h2 id="feedback-modal-title">Give Feedback</h2>

                }
                <p class="feedback-modal-description">
                    <strong>Student:</strong> @selectedSubmission.StudentName
                </p>

                <p class="feedback-modal-description">
                    <strong>Assignment:</strong> @selectedSubmission.ActivityTitle
                </p>

                <div class="feedback-form-field">
                    <label class="form-label" for="feedback-comment">Comment</label>
                    <textarea class="form-control" id="feedback-comment"
                              @bind="feedbackComment"
                              maxlength="2000"
                              rows="5"
                              placeholder="Write your feedback here...">
                    </textarea>
                    <small>Maximum 2000 characters.</small>
                </div>

                <div class="feedback-form-field">
                    <label class="form-label" for="feedback-grade">Grade (0–10)</label>
                    <input class="form-control" id="feedback-grade"
                           type="number"
                           min="0"
                           max="10"
                           step="0.5"
                           @bind="feedbackGrade" />
                </div>

                @if (!string.IsNullOrWhiteSpace(feedbackError))
                {
                    <p class="alert alert-danger submission-error" role="alert">
                        @feedbackError
                    </p>
                }

                <div class="feedback-modal-actions">
                    <button type="button"
                            class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-2"
                            @onclick="CloseFeedback"
                            disabled="@isSubmittingFeedback">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                            @onclick="SubmitFeedbackAsync"
                            disabled="@isSubmittingFeedback">
                        @(isSubmittingFeedback ? "Submitting..." : "Submit Feedback")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading;
    private bool hasError;

    private string errorMessage = "Could not load submissions.";
    private string? downloadError;

    private int courseId;
    private int? selectedActivityId;
    private string selectedStatus = "";

    private int pageNumber = 1;
    private const int PageSize = 20;

    private int totalCount;
    private bool hasMorePages;

    private List<TeacherAssignmentSubmissionDto> submissions = [];
    private List<TeacherAssignmentSubmissionDto> activities = [];

    // US11 #67 - Teacher feedback
    private bool showFeedbackModal;
    private bool isSubmittingFeedback;
    private TeacherAssignmentSubmissionDto? selectedSubmission;
    private string feedbackComment = string.Empty;
    private decimal? feedbackGrade;
    private string? feedbackError;
    private string? feedbackSuccess;
    private FeedbackDto? latestFeedback;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubmissionsAsync();
    }

    private async Task LoadSubmissionsAsync()
    {
        isLoading = true;
        hasError = false;
        downloadError = null;

        try
        {
            var url =
                $"teacher/submissions?PageNumber={pageNumber}" +
                $"&PageSize={PageSize}";

            if (selectedActivityId.HasValue)
            {
                url += $"&activityId={selectedActivityId.Value}";
            }

            if (!string.IsNullOrWhiteSpace(selectedStatus))
            {
                url += $"&status={Uri.EscapeDataString(selectedStatus)}";
            }

            var response =
                await ApiProxyClient.GetAsync<
                    PagedResponse<TeacherAssignmentSubmissionDto>>(url);

            submissions = response?.Items?.ToList() ?? [];
            totalCount = response?.TotalCount ?? 0;

            hasMorePages = pageNumber * PageSize < totalCount;

            activities = activities
                .Concat(submissions)
                .GroupBy(x => x.ActivityId)
                .Select(g => g.First())
                .OrderBy(x => x.ActivityTitle)
                .ToList();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage =
                "Could not load submissions. Check your API connection and teacher authorization.";

            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        pageNumber = 1;
        await LoadSubmissionsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        selectedActivityId = null;
        selectedStatus = "";
        pageNumber = 1;

        await LoadSubmissionsAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadSubmissionsAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (hasMorePages)
        {
            pageNumber++;
            await LoadSubmissionsAsync();
        }
    }

    private int CountStatus(string status) =>
        submissions.Count(x =>
            string.Equals(x.Status, status,
                StringComparison.OrdinalIgnoreCase));

    private static string GetStatusText(string? status) =>
        status?.ToLowerInvariant() switch
        {
            "submitted" => "Submitted",
            "late" => "Late",
            "missing" => "Missing",
            "overdue" => "Overdue",
            _ => status ?? "Unknown"
        };

    private static string GetStatusClass(string? status) =>
        status?.ToLowerInvariant() switch
        {
            "submitted" => "status-submitted",
            "late" => "status-late",
            "missing" => "status-missing",
            "overdue" => "status-overdue",
            _ => "status-unknown"
        };

    private static string GetDownloadUrl(int submissionId) =>
        $"api/proxy/teacher/submissions/{submissionId}/file";

    private async Task OpenFeedback(TeacherAssignmentSubmissionDto submission)
    {
        if (!submission.SubmissionId.HasValue)
            return;

        selectedSubmission = submission;
        feedbackComment = string.Empty;
        feedbackGrade = null;
        feedbackError = null;
        feedbackSuccess = null;
        latestFeedback = null;
        showFeedbackModal = true;
        try
        {
            var existingFeedback =
                await ApiProxyClient.GetAsync<IEnumerable<FeedbackDto>>(
                    $"submissions/{submission.SubmissionId.Value}/feedback");

            // API returns feedback newest first.
             latestFeedback = existingFeedback?.FirstOrDefault();

            if (latestFeedback is not null)
            {
                feedbackComment = latestFeedback.Comment;
                feedbackGrade = latestFeedback.Grade;
            }

        }
        catch (Exception ex)
        {
            feedbackError = "Could not load existing feedback.";
            Console.WriteLine(ex);
        }
    }

    private void CloseFeedback()
    {
        if (isSubmittingFeedback)
            return;

        showFeedbackModal = false;
        selectedSubmission = null;
        feedbackError = null;
    }

    private async Task SubmitFeedbackAsync()
    {
        if (selectedSubmission?.SubmissionId is not int submissionId)
            return;

        feedbackError = null;

        if (string.IsNullOrWhiteSpace(feedbackComment))
        {
            feedbackError = "Comment is required.";
            return;
        }

        if (feedbackComment.Length > 2000)
        {
            feedbackError = "Comment must not exceed 2000 characters.";
            return;
        }

        if (feedbackGrade is null)
        {
            feedbackError = "Grade is required.";
            return;
        }

        if (feedbackGrade < 0 || feedbackGrade > 10)
        {
            feedbackError = "Grade must be between 0 and 10.";
            return;
        }
         
        if (latestFeedback is not null &&
           feedbackComment.Trim() == latestFeedback.Comment &&
           feedbackGrade == latestFeedback.Grade)
        {
            feedbackError = "Change the comment or grade before submitting.";
             return;
        }

        isSubmittingFeedback = true;

        try
        {
            var dto = new CreateFeedbackDto
            {
                Comment = feedbackComment.Trim(),
                Grade = feedbackGrade.Value

            };

            using var content = JsonContent.Create(dto);

            var result = await ApiProxyClient.SendAsync<FeedbackDto>(
                HttpMethod.Post,
                $"submissions/{submissionId}/feedback",
                content);

            if (result is null)
            {
                feedbackError = "Could not confirm that feedback was saved.";
                return;
            }

            feedbackSuccess = "Feedback submitted successfully.";
            showFeedbackModal = false;
            selectedSubmission = null;
        }
        catch (Exception ex)
        {
            feedbackError = "Could not submit feedback. Please try again.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSubmittingFeedback = false;
        }
    }
}
