@LMS.API_HostAddress = http://localhost:5279

# Local seed password. It differs between machines, so update it to match yours:
# dotnet user-secrets list --project LMS.API (key "password")
@SeedPassword = Dev1!KDXKDFZZ9Bbk

########################################
# Users, roles and course link – user story US01
# Run top to bottom.
# Creates one user and deletes it at the end.
########################################

### 1. Teacher logs in (200)
POST {{LMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "Teacher@Lms.com",
  "password": "{{SeedPassword}}"
}

> {%
  client.global.set("teacherToken", response.body.accessToken);
%}

### 2. Student logs in (200)
POST {{LMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "Student@Lms.com",
  "password": "{{SeedPassword}}"
}

> {%
  client.global.set("studentToken", response.body.accessToken);
%}

### 3. Student reads own course, used as the new user's course (200)
GET {{LMS.API_HostAddress}}/api/courses/my-course
Authorization: Bearer {{studentToken}}

> {%
  client.global.set("courseId", response.body.id);
%}

# --- Read users ---

### 4. Teacher lists users (200)
GET {{LMS.API_HostAddress}}/api/users?PageNumber=1&PageSize=20
Authorization: Bearer {{teacherToken}}

### 5. Teacher finds own user (200)
GET {{LMS.API_HostAddress}}/api/users?SearchTerm=Teacher@Lms.com
Authorization: Bearer {{teacherToken}}

> {%
  client.global.set("teacherId", response.body.items[0].id);
%}

### 6. Teacher reads one user (200)
GET {{LMS.API_HostAddress}}/api/users/{{teacherId}}
Authorization: Bearer {{teacherToken}}

### 7. User does not exist (404)
GET {{LMS.API_HostAddress}}/api/users/does-not-exist
Authorization: Bearer {{teacherToken}}

### 8. Student lists users (403)
GET {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{studentToken}}

### 9. No token (401)
GET {{LMS.API_HostAddress}}/api/users

# --- Create user ---

### 10. Teacher creates a student (201)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Http",
  "lastName": "Test",
  "email": "http.test@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

> {%
  client.global.set("newUserId", response.body.user.id);
  client.global.set("setupToken", response.body.passwordSetupToken);
%}

### 11. Same email again (400)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Http",
  "lastName": "Test",
  "email": "http.test@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

### 12. Invalid email (400)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Http",
  "lastName": "Test",
  "email": "not-an-email",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

### 13. Missing first name (400)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Test",
  "email": "http.test2@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

### 14. Role that does not exist (400, returns 500 today)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Http",
  "lastName": "Test",
  "email": "http.test2@lms.com",
  "phoneNumber": "0701234567",
  "role": "Admin",
  "courseId": {{courseId}}
}

### 15. Student creates a user (403)
POST {{LMS.API_HostAddress}}/api/users
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "firstName": "Http",
  "lastName": "Test",
  "email": "http.test2@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

# --- Set password ---

### 16. Passwords do not match (400, returns 500 today)
POST {{LMS.API_HostAddress}}/api/users/set-password
Content-Type: application/json

{
  "userId": "{{newUserId}}",
  "token": "{{setupToken}}",
  "password": "HttpTest!12345",
  "confirmPassword": "Different!12345"
}

### 17. Wrong token (400, returns 500 today)
POST {{LMS.API_HostAddress}}/api/users/set-password
Content-Type: application/json

{
  "userId": "{{newUserId}}",
  "token": "wrong-token",
  "password": "HttpTest!12345",
  "confirmPassword": "HttpTest!12345"
}

### 18. New user sets password (204)
POST {{LMS.API_HostAddress}}/api/users/set-password
Content-Type: application/json

{
  "userId": "{{newUserId}}",
  "token": "{{setupToken}}",
  "password": "HttpTest!12345",
  "confirmPassword": "HttpTest!12345"
}

### 19. New user logs in (200)
POST {{LMS.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "http.test@lms.com",
  "password": "HttpTest!12345"
}

# --- Update user ---

### 20. Teacher updates the user (200)
PUT {{LMS.API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Updated",
  "lastName": "Test",
  "email": "http.test@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

### 21. Update a user that does not exist (404)
PUT {{LMS.API_HostAddress}}/api/users/does-not-exist
Authorization: Bearer {{teacherToken}}
Content-Type: application/json

{
  "firstName": "Nobody",
  "lastName": "Test",
  "email": "http.test@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

### 22. Student updates a user (403)
PUT {{LMS.API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "firstName": "Hacked",
  "lastName": "Test",
  "email": "http.test@lms.com",
  "phoneNumber": "0701234567",
  "role": "Student",
  "courseId": {{courseId}}
}

# --- Delete user ---

### 23. Student deletes the user (403)
DELETE {{LMS.API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{studentToken}}

### 24. Teacher deletes own account (400)
DELETE {{LMS.API_HostAddress}}/api/users/{{teacherId}}
Authorization: Bearer {{teacherToken}}

### 25. Teacher deletes the user (204)
DELETE {{LMS.API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{teacherToken}}

### 26. Delete the same user again (404)
DELETE {{LMS.API_HostAddress}}/api/users/{{newUserId}}
Authorization: Bearer {{teacherToken}}
